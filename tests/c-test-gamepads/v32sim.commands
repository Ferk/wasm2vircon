# Player 3 is processed last, so its right-arrow draw is the final GPU state
# before the frame WAIT instruction.
gamepad3 connect
gamepad3 right
display/X GPU_SelectedTexture selected_texture
display/X GPU_SelectedRegion selected_region
display/X GPU_DrawingPointX drawing_x
display/X GPU_DrawingPointY drawing_y
display/X INP_SelectedGamepad selected_gamepad
